+class TestExhaustionDetector:
+    """Never truncate: exhaustion is reported only on positive evidence."""
+
+    @staticmethod
+    def metrics(top=900, height=1000, client=100, cards=300, busy=0):
+        return {"scrollTop": top, "scrollHeight": height,
+                "clientHeight": client, "cards": cards, "busy": busy}
+
+    @staticmethod
+    def drive(sequence, last_height=1000, last_cards=300, got_fresh=False,
+              dt=2.0):
+        """Run the detector over a sequence of metrics, exactly as the scroll
+        loop does — including how it carries the previous values forward.
+
+        Returns (exhausted, steps).
+        """
+        from modules.scraper import GoogleReviewsScraper as G
+        streak, started, exhausted = 0, None, False
+        steps = 0
+        for i, m in enumerate(sequence):
+            (streak, started, exhausted,
+             last_height, last_cards) = G._exhaustion_step(
+                m, got_fresh, last_height, last_cards, streak, started, i * dt)
+            steps += 1
+            if exhausted:
+                # The scroll loop breaks here; a later reset is never reached.
+                break
+        assert steps <= len(sequence)
+        return exhausted, steps
+
+    def test_flush_at_bottom_and_static_for_three_steps_exhausts(self):
+        ex, n = self.drive([self.metrics()] * 3)
