+"""Contract tests for the batched DOM extractor (modules/dom_batch.py).
+
+No browser required. The browser-backed equivalence gate — which grades the JS
+visible-text port against ChromeDriver's WebElement.text and diffs both
+extraction paths over one DOM — lives in the batched-extraction harness and
+must be run separately; these tests cover the parts that are decidable offline.
+"""
+
+import json
+import re
+
+import pytest
+
+from modules import dom_batch
+from modules.models import RawReview
+
+
+class TestSelectorOwnership:
+    """RawReview is the single owner of every review selector."""
+
+    def test_no_unreplaced_tokens(self):
+        scripts = {
+            "JS_COLLECT_IDS": dom_batch.JS_COLLECT_IDS,
+            "JS_EXPAND_MORE": dom_batch.JS_EXPAND_MORE,
+            "JS_EXTRACT_CARDS": dom_batch.JS_EXTRACT_CARDS,
+            "JS_SCROLL_METRICS": dom_batch.JS_SCROLL_METRICS,
+            "JS_GROWTH_PROBE": dom_batch.JS_GROWTH_PROBE,
+            "JS_VISIBLE_TEXT_OF": dom_batch.JS_VISIBLE_TEXT_OF,
+        }
+        assert scripts, "denominator is zero — nothing was graded"
+        for name, src in scripts.items():
+            leftover = re.findall(r"__[A-Z][A-Z0-9_]*__", src)
+            assert not leftover, f"{name} has unsubstituted tokens: {leftover}"
+
+    def test_every_selector_in_js_comes_from_rawreview(self):
+        """A selector present in the JS but not on RawReview is a second copy.
+
+        Ranges over every selector *group* the extractor templates in, and
+        reports how many it graded so a shrinking selector set is visible as a
+        number that dropped rather than as continued green.
+        """
+        owned = set()
+        for attr in dir(RawReview):
+            if attr.startswith("_") or not attr.isupper():
+                continue
+            value = getattr(RawReview, attr)
+            if isinstance(value, str):
+                owned.add(value)
+            elif isinstance(value, tuple):
+                owned.update(value)
+        assert len(owned) >= 18, f"only {len(owned)} selectors owned by RawReview"
+
+        # Selectors are templated in as JSON, so `"` is escaped in the JS.
+        js = dom_batch.JS_EXTRACT_CARDS
+        graded = sum(1 for sel in owned if json.dumps(sel) in js)
+        # Every selector the extractor uses must appear verbatim in the JS.
+        used = set(RawReview.MORE_BTN) | set(RawReview.RATING_SELECTORS) \
+            | set(RawReview.DATE_SELECTORS) | set(RawReview.TEXT_SELECTORS) \
+            | set(RawReview.PHOTO_BTN_SELECTORS) | set(RawReview.OWNER_RESP_SELECTORS) \
+            | set(RawReview.OWNER_DATE_SELECTORS) | set(RawReview.OWNER_TEXT_SELECTORS) \
+            | set(RawReview.SUB_RATING_SELECTORS) \
+            | {RawReview.LIKE_BTN, RawReview.AUTHOR_SEL,
+               RawReview.PROFILE_SEL, RawReview.AVATAR_SEL}
+        missing = [s for s in used if json.dumps(s) not in js]
+        assert not missing, f"selectors missing from the rendered JS: {missing}"
+        assert graded >= len(used), f"graded only {graded} of {len(used)}"
+
+    def test_js_has_no_invisible_code_points(self):
+        """A regex whose correctness is invisible on screen cannot be reviewed."""
+        import pathlib
+        src = pathlib.Path(dom_batch.__file__).read_text(encoding="utf-8")
+        bad = sorted({hex(ord(c)) for c in src
+                      if ord(c) in (0x00a0, 0x200b, 0x200e, 0x200f, 0xfeff)
+                      or (ord(c) < 0x20 and c not in "\n\t")})
+        assert not bad, f"invisible/control code points in dom_batch.py: {bad}"
+
+
+class TestFromPayloadReplaysTheOldLoops:
