+class _FakeDriver:
+    """Minimal driver stand-in: answers each execute_script from a queue.
+
+    Records every script it was handed, so a test can assert *which* call was
+    made and not only what came back.
+    """
+
+    def __init__(self, answers):
+        self.answers = list(answers)
+        self.scripts = []
+
+    def execute_script(self, script, *args):
+        self.scripts.append((script, args))
+        if not self.answers:
+            raise AssertionError("FakeDriver ran out of answers")
+        a = self.answers.pop(0)
+        if isinstance(a, Exception):
+            raise a
+        return a
+
+    def find_elements(self, *a, **k):
+        return []
+
+
+def _scraper(tmp_path, **cfg):
+    from modules.scraper import GoogleReviewsScraper
+    base = {"db_path": str(tmp_path / "t.db")}
+    base.update(cfg)
+    return GoogleReviewsScraper(base)
+
+
+class TestCollectFreshIds:
+    """The O(n^2) rescan replacement, and its T1 fallback."""
+
+    def test_batched_scan_partitions_ids(self, tmp_path):
+        s = _scraper(tmp_path)
+        d = _FakeDriver([["a", "b", "c"]])
+        fresh, seen_count, by_id = s._collect_fresh_ids(
+            d, None, ["handle"], processed_ids=set(), seen={"b"})
+        assert fresh == ["a", "c"]
+        assert seen_count == 1
+        assert by_id == {}
+        assert len(d.scripts) == 1, "must be ONE round trip, not one per card"
+
+    def test_already_processed_ids_are_skipped(self, tmp_path):
+        s = _scraper(tmp_path)
+        d = _FakeDriver([["a", "b"]])
+        processed = {"a"}
+        fresh, seen_count, _ = s._collect_fresh_ids(
+            d, None, ["h"], processed_ids=processed, seen=set())
+        assert fresh == ["b"]
+        assert processed == {"a", "b"}
+
