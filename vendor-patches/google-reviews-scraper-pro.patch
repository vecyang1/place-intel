+    def test_two_steps_is_not_enough(self):
+        from modules.scraper import EXHAUST_STREAK
+        assert EXHAUST_STREAK == 3, "threshold changed — is that intended?"
+        # dt is well past EXHAUST_MIN_SECONDS so ONLY the streak rule can
+        # decide this; otherwise the time floor masks a streak regression.
+        assert self.drive([self.metrics()] * 2, dt=5.0)[0] is False
+        assert self.drive([self.metrics()] * 3, dt=5.0)[0] is True
+
+    def test_three_steps_inside_the_time_floor_is_not_enough(self):
+        """Three fast iterations fit inside one XHR round trip."""
