+
+    def test_photos_order_preserving_dedupe(self):
+        styles = ['background-image: url("https://x/A");',
+                  'background-image: url("https://x/B");',
+                  'background-image: url("https://x/A");']
+        raw = RawReview.from_payload(self.payload(photo_styles=[styles, [], []]))
+        assert raw.photos == ["https://x/A", "https://x/B"]
+
+    def test_photo_selector_that_matches_but_yields_nothing_falls_through(self):
+        """models.py:140 breaks only when `photos` is non-empty."""
+        raw = RawReview.from_payload(self.payload(photo_styles=[
+            ["color: red;"], ['background-image: url("https://x/C");'], []]))
+        assert raw.photos == ["https://x/C"]
+
+    def test_owner_response_absent(self):
+        raw = RawReview.from_payload(self.payload())
+        assert raw.owner_text == "" and raw.owner_date == ""
+
+    def test_owner_response_present(self):
+        raw = RawReview.from_payload(self.payload(
+            owner_date_texts=[["2 months ago"], []],
+            owner_text_texts=[[""], ["Thanks!"]]))
+        assert raw.owner_date == "2 months ago"
+        assert raw.owner_text == "Thanks!"
+
+    def test_sub_ratings_aria_wins_and_text_is_the_fallback(self):
+        raw = RawReview.from_payload(self.payload(sub_labels=[[
+            {"aria": "Service: 5/5", "text": None},
