+    _EXHAUST_REQUIRED_KEYS = ("scrollTop", "scrollHeight", "clientHeight", "cards")
+
+    @classmethod
+    def _exhaustion_step(cls, metrics, got_fresh, last_height, last_cards,
+                         streak, started, now):
+        """One step of the pane-exhaustion detector.
+
+        Returns (streak, started, exhausted, next_height, next_cards).
+
+        Owns the *whole* rule, including how the previous-iteration values are
+        carried forward, so the "previous value, not a high-water mark" choice
+        cannot drift into the caller. Conservative by construction: exhaustion
+        is reported only on positive evidence, so any missing signal falls
+        through to the pre-existing `idle >= max_idle` bound.
+        """
+        usable = isinstance(metrics, dict) and all(
+            k in metrics for k in cls._EXHAUST_REQUIRED_KEYS)
+        if not usable:
+            # Absent metrics are unknown. Carry the previous values forward
+            # rather than writing back a zero nothing measured.
+            return 0, None, False, last_height, last_cards
