+"""Browser-backed parity gate for the batched DOM extractor.
+
+`tests/test_dom_batch.py` drives a `_FakeDriver` that answers `execute_script`
+from a queue — it grades the Python around the JS and **executes no JavaScript
+at all**. That leaves the risky half ungated: `dom_batch.JS_VISIBLE_TEXT` is a
+75-line hand port of ChromeDriver's `bot.dom.getVisibleText` atom, and a single
+divergence on a construct Google uses in review bodies changes `text`, and with
+it the content hash, `review_date` and `lang` — so `upsert_review` would report
+every review as `changed` on every run, forever.
+
+This file is the gate that can turn red for that. It launches real headless
+Chrome and asserts two things against the *same* DOM:
+
+  1. the JS visible-text port equals `WebElement.text` element by element;
+  2. the batched path and the original per-card path produce identical
+     `RawReview`s, `review_id` included.
+
+It reports how many elements and cards it graded, so a selector that silently
+stops matching shows up as a number that dropped rather than as continued green.
+"""
+
+from __future__ import annotations
+
+import uuid
+from pathlib import Path
+
+from dataclasses import replace
+
+import pytest
+from selenium.webdriver.common.by import By
+
+HERE = Path(__file__).resolve().parent
+FIXTURE = (HERE / "fixtures" / "reviews_fixture.html").as_uri()
+
+# Constructs where a naive innerText port diverges from ChromeDriver. Each one
+# cost a real mismatch during development; keep them.
+PROBE_EXTRA = """
+<div id="probe-extra">
+  <div style="display:none">hidden text</div>
+  <div style="visibility:hidden">invisible text</div>
+  <span>zero​width</span>
+  <p>para one</p><p>para two</p>
+  <div>a<br><br>b</div>
+  <table><tr><td>c1</td><td>c2</td></tr></table>
+  <div>   </div>
+  <div>nbsp joined</div>
+  <div style="white-space:pre-line">pre
+line</div>
+</div>
+"""
+
+
+@pytest.fixture(scope="module")
+def driver():
+    sb = pytest.importorskip("seleniumbase")
+    from seleniumbase import config as sb_config
+    from seleniumbase.config import settings as sb_settings
+
+    drv_dir = Path("/tmp") / f"grs-parity-{uuid.uuid4().hex[:8]}"
+    drv_dir.mkdir(parents=True, exist_ok=True)
+    # Without these, SeleniumBase probes debug port 9222 and collides with any
+    # other Chrome on the machine — the failure looks like a parity failure.
+    sb_config.multi_proxy = True
+    sb_settings.NEW_DRIVER_DIR = str(drv_dir)
+    sb_config.settings = sb_settings
+    d = sb.Driver(uc=True, headless=True, undetectable=True)
+    try:
+        yield d
+    finally:
+        try:
+            d.quit()
+        except Exception:
+            pass
+
+
+def test_visible_text_port_matches_chromedriver(driver):
+    from modules import dom_batch
+
+    driver.get(FIXTURE)
+    driver.execute_script(
+        "document.body.insertAdjacentHTML('beforeend', arguments[0]);", PROBE_EXTRA
+    )
+    els = driver.find_elements(
+        By.CSS_SELECTOR,
+        "div[role='main'], div[role='main'] *, #probe-extra, #probe-extra *",
+    )
+    graded, bad = 0, []
+    for e in els:
+        try:
+            expected = e.text
+        except Exception:
+            continue
+        actual = driver.execute_script(dom_batch.JS_VISIBLE_TEXT_OF, e)
+        graded += 1
+        if expected != actual:
+            bad.append((e.tag_name, e.get_attribute("id"), repr(expected), repr(actual)))
+
+    # A parity run over nothing is not a pass. The fixture plus the probe block
+    # reliably yield 100+ elements; a collapse means the selector stopped matching.
+    assert graded >= 50, f"graded only {graded} elements — the selector stopped matching"
+    assert not bad, f"vtext diverged from WebElement.text on {len(bad)}/{graded}: {bad[:5]}"
+    print(f"\nvtext parity: {graded} elements graded, 0 mismatches")
+
+
+def test_batched_and_per_card_paths_agree(driver):
+    from modules import dom_batch
+    from modules.models import RawReview
+
+    # Batched path.
+    driver.get(FIXTURE)
+    pane = driver.find_element(By.CSS_SELECTOR, "div[role='main']")
+    ids = dom_batch.collect_ids(driver, pane)
+    assert ids, "collect_ids returned nothing — the fixture or the selector broke"
+    dom_batch.expand_more(driver, ids)
+    payloads = dom_batch.extract_cards(driver, ids)
+    assert payloads, "extract_cards returned nothing"
+    batched = {p["id"]: RawReview.from_payload(p) for p in payloads}
+
+    # Per-card path, on a fresh DOM (from_card clicks "More" itself).
+    driver.get(FIXTURE)
+    per_card = {}
+    for card in driver.find_elements(By.CSS_SELECTOR, "div[data-review-id]"):
+        raw = RawReview.from_card(card)
+        per_card[raw.id] = raw
+
+    assert per_card, "fixture produced no cards — the gate has a zero denominator"
+    assert set(batched) == set(per_card), (
+        f"id sets differ: batched-only={set(batched) - set(per_card)}, "
+        f"per-card-only={set(per_card) - set(batched)}"
+    )
+    # `review_date` is derived from a RELATIVE string ("2 hours ago") against
+    # `utcnow()` at the moment each path runs, and the two paths run seconds
+    # apart — so comparing it exactly asserts that the clock did not move. It
+    # did: measured 16:34:21 vs 16:34:26 on the same fixture, which made this
+    # gate permanently red and therefore no gate at all. Compare it to the
+    # second-independent part and everything else exactly.
+    for rid in per_card:
+        a, b = batched[rid], per_card[rid]
+        a_date, b_date = a.review_date, b.review_date
+        assert (a_date or "")[:10] == (b_date or "")[:10], (
+            f"card {rid} resolved to different DAYS: {a_date} vs {b_date}")
+        a, b = replace(a, review_date=""), replace(b, review_date="")
+        assert a == b, f"card {rid} differs between paths"
+    print(f"\npath equivalence: {len(per_card)} cards identical, review_id included")
