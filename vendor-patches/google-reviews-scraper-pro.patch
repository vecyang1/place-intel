@@ -0,0 +1,53 @@
+"""Every relative-date unit Google Maps actually renders must convert.
+
+Regression, 2026-08-31: the English pattern matched only day/week/month/year,
+so anything younger than a day converted to None — while this module's own
+docstring listed "an hour ago" as supported. The newest reviews on every page
+are exactly the ones under a day old, and a consumer that sorts on
+`review_date or ""` descending puts undated rows LAST and truncates them first.
+Measured on a live place: one "2 hours ago" review out of 85 was the only row
+with no date, and it was the most recent one.
+"""
+from datetime import datetime, timedelta
+
+import pytest
+
+from modules.date_converter import relative_to_datetime
+
+# The module builds its answers from `datetime.utcnow()`, so the reference
+# has to be UTC too — comparing against local time fails by the offset,
+# which reads exactly like a broken converter on any non-UTC machine.
+NOW = datetime.utcnow()
+
+
+@pytest.mark.parametrize("text,delta", [
+    ("30 seconds ago", timedelta(seconds=30)),
+    ("a minute ago", timedelta(minutes=1)),
+    ("5 minutes ago", timedelta(minutes=5)),
+    ("an hour ago", timedelta(hours=1)),
+    ("2 hours ago", timedelta(hours=2)),
+    ("a day ago", timedelta(days=1)),
+    ("2 days ago", timedelta(days=2)),
+    ("2 weeks ago", timedelta(weeks=2)),
+    ("a month ago", timedelta(days=30)),
+    ("3 years ago", timedelta(days=365 * 3)),
+])
+def test_every_rendered_unit_converts(text, delta):
+    moment = relative_to_datetime(text, "en")
+    assert moment is not None, f"{text!r} did not convert"
+    # One minute of slack for the clock moving between the two `now` reads.
+    assert abs((NOW - delta) - moment) < timedelta(minutes=1)
+
+
+@pytest.mark.parametrize("text", ["just now", "now", "a moment ago", "moments ago"])
+def test_the_unitless_present_converts(text):
+    moment = relative_to_datetime(text, "en")
+    assert moment is not None, f"{text!r} did not convert"
+    assert abs(NOW - moment) < timedelta(minutes=1)
+
+
+@pytest.mark.parametrize("text", ["", "gibberish", "sometime last winter", "yesterday"])
+def test_what_it_cannot_read_stays_none_rather_than_becoming_now(text):
+    # None means "unknown age". Defaulting to `now` would sort an unknown review
+    # to the very top of a newest-first list.
+    assert relative_to_datetime(text, "en") is None
