+class TestStaleLikeButtonIsNotZero:
+    """A like count we could not read must never be stored as a stated 0.
+
+    Before batching, `from_card` let StaleElementReferenceException escape and
+    the scroll loop skipped the whole card, picking it up next iteration. The
+    batching refactor briefly caught it and substituted `""`/`None`, which
+    `safe_int` turns into `0` — writing a wrong number to the DB and flipping
+    `engagement_hash` (sha256 of f"{likes}|{owner_text}") for every affected
+    review. One deferred card is cheaper than a confident wrong count.
+    """
+
+    def test_stale_like_button_propagates_instead_of_storing_zero(self):
+        from selenium.common.exceptions import (NoSuchElementException,
+                                                StaleElementReferenceException)
+
+        from modules.models import RawReview
+
+        class _StaleBtn:
+            @property
+            def text(self):
+                raise StaleElementReferenceException("like button unmounted")
+
+            def get_attribute(self, name):
+                raise StaleElementReferenceException("like button unmounted")
+
+        class _Card:
+            """Everything is absent except the like button, which is stale.
+
+            `try_find` swallows NoSuchElement/Stale, so a bare "no match" must be
+            NoSuchElementException — anything else would be swallowed by the
+            broad handler in the scroll loop and hide what we are testing.
+            """
+
+            def find_element(self, by, sel):
+                if RawReview.LIKE_BTN in sel or "toggleThumbsUp" in sel:
+                    return _StaleBtn()
+                raise NoSuchElementException(sel)
+
+            def find_elements(self, by, sel):
+                return []
+
+            def get_attribute(self, name):
+                return "rev-stale" if name == "data-review-id" else None
+
+        with pytest.raises(StaleElementReferenceException):
+            RawReview.from_card(_Card())
