+class TestWrappersDegradeInsteadOfRaising:
+    """Each wrapper returns None on a WebDriver error — the T1/T2 contract."""
+
+    class _Boom:
+        def execute_script(self, *a, **k):
+            from selenium.common.exceptions import JavascriptException
+            raise JavascriptException("boom")
+
+    class _Wrong:
+        def __init__(self, value):
+            self.value = value
+
+        def execute_script(self, *a, **k):
+            return self.value
+
+    def test_collect_ids_none_on_error(self):
+        assert dom_batch.collect_ids(self._Boom(), None) is None
+
+    def test_collect_ids_none_on_wrong_shape(self):
+        assert dom_batch.collect_ids(self._Wrong("not-a-list"), None) is None
+
+    def test_collect_ids_passes_a_list_through(self):
+        assert dom_batch.collect_ids(self._Wrong(["a", "b"]), None) == ["a", "b"]
