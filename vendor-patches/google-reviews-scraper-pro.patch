+++ b/modules/dom_batch.py
@@ -0,0 +1,549 @@
+"""
+Batched DOM reads for the review scroll loop.
+
+Why this module exists
+----------------------
+``RawReview.from_card`` used 25-30 individual Selenium round trips per review,
+and the dedup rescan in ``scraper.py`` re-read ``data-review-id`` off *every*
+card in the DOM on *every* scroll iteration (O(n^2)).  Selenium 4.44 implements
+``WebElement.get_attribute`` as an ``execute_script`` that ships a 4754-byte JS
+atom per call, so both loops were paying a full WebDriver round trip per field.
+
+The scripts here do the same DOM reads in one ``execute_script`` per scroll
+iteration instead of thousands.  They deliberately return **raw DOM strings**,
+not finished fields: all parsing (dates, language, sub-rating canonicalisation)
+stays in Python so there is exactly one parser.  See ``RawReview.from_payload``.
+
+Equivalence guarantees
+----------------------
+* ``review_id`` — ``card.getAttribute('data-review-id')`` is literally the DOM
+  call Selenium's ``getAttribute.js`` atom makes for a hyphenated data-attribute
+  (atom branch 7: ``element['data-review-id']`` is ``undefined``, so the atom
+  falls through to ``getAttribute``).  Byte-identity holds by construction.
+* ``JS_GET_ATTRIBUTE`` is a transcription of
+  ``selenium/webdriver/remote/getAttribute.js`` (4754 bytes, selenium 4.44.0),
+  including the ``style`` -> ``cssText`` and ``IMG.src`` -> resolved-URL
+  branches that a naive ``getAttribute`` call would get wrong.
+* ``JS_VISIBLE_TEXT`` reproduces ChromeDriver's ``Get Element Text`` (what
+  ``WebElement.text`` returns).  That is *not* ``innerText``; it differs on
+  non-rendered elements, zero-width characters, ``<p>`` spacing, table cells
+  and NBSP.  The implementation here was derived by measurement and graded
+  element-by-element against ``WebElement.text``; see the parity harness.
+
+Every script is best-effort: the wrappers return ``None`` on any WebDriver
+error so the caller can fall back to the per-card Selenium path.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, List, Optional
+
+from selenium.common.exceptions import WebDriverException
+
+from modules.models import RawReview
+
+log = logging.getLogger("scraper")
+
+# The card selector. Mirrors scraper.CARD_SEL; duplicated here rather than
+# imported to avoid a circular import (scraper imports this module).
+CARD_SEL = "div[data-review-id]"
+
+# Fallback chain used by the id scan, mirroring scraper.py's three-step
+# `cards = ...` lookup so the batched scan sees exactly the same card set.
+CARD_SEL_FALLBACK = "div.jJc9Ad, div[data-review-id], div.GHT2ce"
+
+# Selector used to detect an in-flight load. `[role="progressbar"]` is the only
+# probe justified by the ARIA contract; Google's concrete spinner class is not
+# known here. A false 0 is safe: `busy` can only ever *block* an early exit.
+BUSY_SEL = 'div[role="main"] [role="progressbar"]'
+
+
+# --------------------------------------------------------------------------
+# Shared JS helpers
+# --------------------------------------------------------------------------
+
+# Faithful transcription of selenium/webdriver/remote/getAttribute.js so that
+# batched attribute reads return the same string Selenium would have returned.
+JS_GET_ATTRIBUTE = r"""
+var PROPERTY_ALIASES = { 'readonly': 'readOnly' };
+var BOOLEAN_PROPERTIES = ['allowfullscreen','allowpaymentrequest','allowusermedia',
+  'async','autofocus','autoplay','checked','compact','complete','controls','declare',
+  'default','defaultchecked','defaultselected','defer','disabled','ended',
+  'formnovalidate','hidden','indeterminate','iscontenteditable','ismap','itemscope',
+  'loop','multiple','muted','nohref','nomodule','noresize','noshade','novalidate',
+  'nowrap','open','paused','playsinline','pubdate','readonly','required','reversed',
+  'scoped','seamless','seeking','selected','truespeed','typemustmatch','willvalidate'];
+
+function rawAttr(el, name) { return el.getAttribute(name.toLowerCase()); }
+function rawProp(el, name) { return el[name]; }
+
+function isTag(node, tagName) {
+  if (!node || node.nodeType !== 1) return false;
+  if (!tagName) return true;
+  return typeof node.tagName === 'string' &&
+         node.tagName.toUpperCase() === tagName.toUpperCase();
+}
+function isSelectable(el) {
+  if (isTag(el, 'OPTION')) return true;
+  if (isTag(el, 'INPUT')) {
+    var t = String(el.type || '').toLowerCase();
+    return t === 'checkbox' || t === 'radio';
+  }
+  return false;
+}
+function isSelectedEl(el) {
+  if (isTag(el, 'OPTION')) return el.selected;
+  var t = el.type ? String(el.type).toLowerCase() : undefined;
+  if (t === 'checkbox' || t === 'radio') return el.checked;
+  return false;
+}
+function isObj(v) {
+  return v !== null && (typeof v === 'object' || typeof v === 'function');
+}
+
+function gattr(element, attribute) {
+  var name = attribute.toLowerCase();
+  if (name === 'style') {
+    var style = element.style;
+    if (!style) return null;
+    return (typeof style === 'string') ? style : style.cssText;
+  }
+  if ((name === 'selected' || name === 'checked') && isSelectable(element)) {
+    return isSelectedEl(element) ? 'true' : null;
+  }
+  var isLink = isTag(element, 'A');
+  var isImg = isTag(element, 'IMG');
+  if ((isImg && name === 'src') || (isLink && name === 'href')) {
+    var av = rawAttr(element, name);
+    if (av) return String(rawProp(element, name));
+    return av;
+  }
+  if (name === 'spellcheck') {
+    var sv = rawAttr(element, name);
+    if (sv !== null) {
+      var lower = sv.toLowerCase();
+      if (lower === 'false') return 'false';
+      if (lower === 'true') return 'true';
+    }
+    return String(rawProp(element, name));
+  }
+  var propName = PROPERTY_ALIASES[attribute] || attribute;
+  if (BOOLEAN_PROPERTIES.indexOf(name) !== -1) {
+    var hasAttr = rawAttr(element, attribute) !== null;
+    var pv = rawProp(element, propName);
+    return (hasAttr || !!pv) ? 'true' : null;
+  }
+  if (name === 'value' && isTag(element, 'LI')) {
+    var lv = rawAttr(element, attribute);
+    return lv != null ? lv : null;
+  }
+  var property;
+  try { property = rawProp(element, propName); } catch (e) { property = undefined; }
+  if (property == null || isObj(property)) {
+    var fv = rawAttr(element, attribute);
+    return fv != null ? fv : null;
+  }
+  return property != null ? String(property) : null;
+}
+"""
+
+# Reproduction of ChromeDriver's "Get Element Text" (WebElement.text).
+# Derived by measurement, not from ChromeDriver source (the atom is not
+# recoverable from the shipped binary). Graded element-by-element against
+# WebElement.text over the review DOM plus adversarial probes.
+JS_VISIBLE_TEXT = r"""
+var VT_INLINE_BOXES = {
+  'inline': 1, 'inline-block': 1, 'inline-table': 1, 'none': 1,
+  'table-cell': 1, 'table-column': 1, 'table-column-group': 1
+};
+var VT_ZERO_WIDTH = /[\u200b\u200e\u200f]/g;  /* ZWSP, LRM, RLM — ChromeDriver drops these */
+var VT_TRIM_R = /[ \t\n\r\f]+$/;
+var VT_TRIM_L = /^[ \t\n\r\f]+/;
+
+function vtDisplayedChain(el) {
+  for (var n = el; n && n.nodeType === 1; n = n.parentElement) {
+    var s;
+    try { s = window.getComputedStyle(n); } catch (e) { return false; }
+    if (!s || s.display === 'none') return false;
+  }
+  return true;
+}
+
+/* Equivalent of Selenium's WebElement.text for `root`. */
+function vtext(root) {
+  var lines = [], pres = [];
+
+  function push(isPre) { lines.push(''); pres.push(!!isPre); }
+  function cur() { return lines.length ? lines[lines.length - 1] : ''; }
+  function blank(s) { return !/\S/.test(s); }
+
+  function appendText(node, cs) {
+    var t = node.nodeValue;
+    if (t == null || t === '') return;
+    var ws = cs ? cs.whiteSpace : 'normal';
+    var pre = (ws === 'pre' || ws === 'pre-wrap' || ws === 'break-spaces');
+    var preLine = (ws === 'pre-line');
+    if (preLine) t = t.replace(/[ \t\r\f]+/g, ' ');
+    else if (!pre) t = t.replace(/[ \n\t\r\f]+/g, ' ');
+    var tt = cs ? cs.textTransform : 'none';
+    if (tt === 'uppercase') t = t.toUpperCase();
+    else if (tt === 'lowercase') t = t.toLowerCase();
+    else if (tt === 'capitalize') {
+      t = t.replace(/(^|[\s\u00a0])(\S)/g, function (m, a, b) { return a + b.toUpperCase(); });
+    }
+    t = t.replace(VT_ZERO_WIDTH, '');
+    if (t === '') return;
+    if (!lines.length) push(false);
+    var parts = (pre || preLine) ? t.split('\n') : [t];
+    for (var i = 0; i < parts.length; i++) {
+      if (i > 0) push(pre || preLine);
+      var seg = parts[i];
+      var c = lines[lines.length - 1];
+      if (!pre && seg.charAt(0) === ' ' && (c === '' || c.charAt(c.length - 1) === ' ')) {
+        seg = seg.slice(1);
+      }
+      if (seg === '' && !(pre || preLine)) continue;
+      lines[lines.length - 1] = c + seg;
+      if (pre || preLine) pres[pres.length - 1] = true;
+    }
+  }
+
+  function walk(el, displayed) {
+    var tag = el.tagName ? el.tagName.toUpperCase() : '';
+    if (tag === 'BR') { push(false); return; }
+    var cs = null;
+    try { cs = window.getComputedStyle(el); } catch (e) { cs = null; }
+    var display = cs ? cs.display : 'block';
+    var here = displayed && display !== 'none';
+    var visible = here && (!cs || cs.visibility === 'visible');
+    var isCell = (tag === 'TD' || tag === 'TH');
+    var isBlock = !isCell && !VT_INLINE_BOXES[display];
+    if (isBlock && !blank(cur())) push(false);
+    if (isCell) {
+      var c0 = cur();
+      if (c0 !== '' && c0.charAt(c0.length - 1) !== ' ') lines[lines.length - 1] = c0 + ' ';
+    }
+    var kids = el.childNodes;
+    for (var i = 0; i < kids.length; i++) {
+      var n = kids[i];
+      if (n.nodeType === 3) { if (visible) appendText(n, cs); }
+      else if (n.nodeType === 1) walk(n, here);
+    }
+    if (isBlock && !blank(cur())) push(false);
+  }
+
+  walk(root, vtDisplayedChain(root));
+
+  for (var i = 0; i < lines.length; i++) {
+    if (!pres[i]) lines[i] = lines[i].replace(VT_TRIM_R, '');
+  }
+  while (lines.length && !pres[lines.length - 1] && lines[lines.length - 1] === '') {
+    lines.pop(); pres.pop();
+  }
+  while (lines.length && !pres[0] && lines[0] === '') { lines.shift(); pres.shift(); }
+  if (lines.length && !pres[0]) lines[0] = lines[0].replace(VT_TRIM_L, '');
+  /* NBSP -> space, last, so the trims above never see \u00a0 */
+  return lines.join('\n').replace(/\u00a0/g, ' ');
+}
+
+/* Per-selector raw reads. Python replays utils.first_text / first_attr over
+   these lists, so the "first non-empty after strip()" rule stays in Python. */
+function textsFor(root, sel) {
+  var out = [], els = root.querySelectorAll(sel);
+  for (var i = 0; i < els.length; i++) out.push(vtext(els[i]));
+  return out;
+}
+function attrsFor(root, sel, name) {
+  var out = [], els = root.querySelectorAll(sel);
+  for (var i = 0; i < els.length; i++) out.push(gattr(els[i], name));
+  return out;
+}
+function textsPerSel(root, sels) {
+  var out = [];
+  for (var i = 0; i < sels.length; i++) out.push(textsFor(root, sels[i]));
+  return out;
+}
+function attrsPerSel(root, sels, name) {
+  var out = [];
+  for (var i = 0; i < sels.length; i++) out.push(attrsFor(root, sels[i], name));
+  return out;
+}
+"""
+
+
+# --------------------------------------------------------------------------
+# Scripts
+# --------------------------------------------------------------------------
+
+_JS_COLLECT_IDS = r"""
+return (function (pane) {
+  "use strict";
+  var cards = null;
+  if (pane) cards = pane.querySelectorAll(__CARD_SEL__);
+  if (!cards || !cards.length) cards = document.querySelectorAll(__CARD_SEL__);
+  if (!cards.length) cards = document.querySelectorAll(__CARD_SEL_FALLBACK__);
+  var out = new Array(cards.length);
+  for (var i = 0; i < cards.length; i++) {
+    var v = cards[i].getAttribute('data-review-id');
+    out[i] = (v == null) ? '' : v;
+  }
+  return out;
+})(arguments[0]);
+"""
+
+_JS_EXPAND_MORE = r"""
+return (function (wantedIds) {
+  "use strict";
+  var MORE_SELS = __MORE_SELS__;
+  var want = wantedIds ? new Set(wantedIds) : null;
+  var cards = document.querySelectorAll(__CARD_SEL__);
+  var clicked = 0, seen = 0;
+  for (var i = 0; i < cards.length; i++) {
+    var card = cards[i];
+    var rid = card.getAttribute('data-review-id');
+    if (want && !want.has(rid == null ? '' : rid)) continue;
+    seen++;
+    for (var s = 0; s < MORE_SELS.length; s++) {
+      var btns = card.querySelectorAll(MORE_SELS[s]);
+      if (!btns.length) continue;
+      for (var b = 0; b < btns.length; b++) {
+        try { btns[b].click(); clicked++; } catch (e) { /* models.py:88 swallows */ }
+      }
+      break;
+    }
+  }
+  return { clicked: clicked, cards: seen };
+})(arguments[0]);
+"""
+
+_JS_EXTRACT_CARDS = r"""
+return (function (wantedIds) {
+  "use strict";
+__GET_ATTRIBUTE__
+__VISIBLE_TEXT__
+
+  var AUTHOR_SEL  = __AUTHOR_SEL__;
+  var PROFILE_SEL = __PROFILE_SEL__;
+  var AVATAR_SEL  = __AVATAR_SEL__;
+  var LIKE_SEL    = __LIKE_SEL__;
+  var RATING_SELS = __RATING_SELS__;
+  var DATE_SELS   = __DATE_SELS__;
+  var TEXT_SELS   = __TEXT_SELS__;
+  var PHOTO_SELS  = __PHOTO_SELS__;
+  var OWNER_SELS  = __OWNER_SELS__;
+  var ODATE_SELS  = __ODATE_SELS__;
+  var OTEXT_SELS  = __OTEXT_SELS__;
+  var SUB_SELS    = __SUB_SELS__;
+  var MORE_SELS   = __MORE_SELS__;
+
+  var want  = wantedIds ? new Set(wantedIds) : null;
+  var cards = document.querySelectorAll(__CARD_SEL__);
+  var out   = [];
+
+  for (var i = 0; i < cards.length; i++) {
+    var card   = cards[i];
+    var ridRaw = card.getAttribute('data-review-id');
+    var rid    = (ridRaw == null) ? '' : ridRaw;
+    if (want && !want.has(rid)) continue;
+
+    var rec = {
+      id:            rid,
+      author_texts:  textsFor(card, AUTHOR_SEL),
+      profile_attrs: attrsFor(card, PROFILE_SEL, 'data-href'),
+      avatar_attrs:  attrsFor(card, AVATAR_SEL, 'src'),
+      rating_attrs:  attrsPerSel(card, RATING_SELS, 'aria-label'),
+      date_texts:    textsPerSel(card, DATE_SELS),
+      text_texts:    textsPerSel(card, TEXT_SELS),
+      like_present:  false,
+      like_text:     null,
+      like_aria:     null,
+      photo_styles:  [],
+      owner_date_texts: null,
+      owner_text_texts: null,
+      sub_labels:    [],
+      more_left:     0
+    };
+
+    /* likes — models.py:124-126. try_find(all=False) == querySelector. */
+    var likeBtn = card.querySelector(LIKE_SEL);
+    if (likeBtn) {
+      rec.like_present = true;
+      rec.like_text    = vtext(likeBtn);
+      rec.like_aria    = gattr(likeBtn, 'aria-label');
+    }
+
+    /* photos — models.py:128-141. One group per selector; Python replays the
+       "continue on empty, break only when photos non-empty" loop. */
+    for (var p = 0; p < PHOTO_SELS.length; p++) {
+      var btns = card.querySelectorAll(PHOTO_SELS[p]);
+      var group = [];
+      for (var b = 0; b < btns.length; b++) group.push(gattr(btns[b], 'style'));
+      rec.photo_styles.push(group);
+    }
+
+    /* owner response — models.py:143-157. First matching box wins, then an
+       unconditional break, so only that box is ever read. */
+    for (var o = 0; o < OWNER_SELS.length; o++) {
+      var box = card.querySelector(OWNER_SELS[o]);
+      if (!box) continue;
+      rec.owner_date_texts = textsPerSel(box, ODATE_SELS);
+      rec.owner_text_texts = textsPerSel(box, OTEXT_SELS);
+      break;
+    }
+
+    /* sub-ratings — models.py:178-207. `text` is evaluated only when `aria`
+       is falsy, which is exactly when Python's `or` reaches block.text. */
+    for (var s2 = 0; s2 < SUB_SELS.length; s2++) {
+      var blocks = card.querySelectorAll(SUB_SELS[s2]);
+      var labels = [];
+      for (var k = 0; k < blocks.length; k++) {
+        var a = gattr(blocks[k], 'aria-label');
+        labels.push({ aria: a, text: a ? null : vtext(blocks[k]) });
+      }
+      rec.sub_labels.push(labels);
+    }
+
+    /* how many "More" buttons survived the expand pass (telemetry only) */
+    for (var m = 0; m < MORE_SELS.length; m++) {
+      var left = card.querySelectorAll(MORE_SELS[m]);
+      if (left.length) { rec.more_left = left.length; break; }
+    }
+
+    out.push(rec);
+  }
+  return out;
+})(arguments[0]);
+"""
+
+_JS_SCROLL_METRICS = r"""
+  return {
+    scrollTop:    scrollContainer ? scrollContainer.scrollTop    : 0,
+    scrollHeight: scrollContainer ? scrollContainer.scrollHeight : 0,
+    clientHeight: scrollContainer ? scrollContainer.clientHeight : 0,
+    cards:        document.querySelectorAll(__CARD_SEL__).length,
+    busy:         document.querySelectorAll(__BUSY_SEL__).length
+  };
+"""
+
+_JS_GROWTH_PROBE = r"""
+return [document.querySelectorAll(__CARD_SEL__).length,
+        (window.scrollablePane ? window.scrollablePane.scrollHeight : 0)];
+"""
+
+
+def _render(template: str) -> str:
+    """Substitute selector tokens.
+
+    Selectors have exactly one owner — ``RawReview`` in ``modules/models.py``.
+    Templating them in at import time means a selector fix lands in one place
+    instead of drifting between the Python and JS copies.  ``tests/`` asserts
+    that every selector literal in the rendered JS comes from ``RawReview``.
+    """
+    subs = {
+        "__CARD_SEL__": json.dumps(CARD_SEL),
+        "__CARD_SEL_FALLBACK__": json.dumps(CARD_SEL_FALLBACK),
+        "__BUSY_SEL__": json.dumps(BUSY_SEL),
+        "__AUTHOR_SEL__": json.dumps(RawReview.AUTHOR_SEL),
+        "__PROFILE_SEL__": json.dumps(RawReview.PROFILE_SEL),
+        "__AVATAR_SEL__": json.dumps(RawReview.AVATAR_SEL),
+        "__LIKE_SEL__": json.dumps(RawReview.LIKE_BTN),
+        "__RATING_SELS__": json.dumps(list(RawReview.RATING_SELECTORS)),
+        "__DATE_SELS__": json.dumps(list(RawReview.DATE_SELECTORS)),
+        "__TEXT_SELS__": json.dumps(list(RawReview.TEXT_SELECTORS)),
+        "__PHOTO_SELS__": json.dumps(list(RawReview.PHOTO_BTN_SELECTORS)),
+        "__OWNER_SELS__": json.dumps(list(RawReview.OWNER_RESP_SELECTORS)),
+        "__ODATE_SELS__": json.dumps(list(RawReview.OWNER_DATE_SELECTORS)),
+        "__OTEXT_SELS__": json.dumps(list(RawReview.OWNER_TEXT_SELECTORS)),
+        "__SUB_SELS__": json.dumps(list(RawReview.SUB_RATING_SELECTORS)),
+        "__MORE_SELS__": json.dumps(list(RawReview.MORE_BTN)),
+        "__GET_ATTRIBUTE__": JS_GET_ATTRIBUTE,
+        "__VISIBLE_TEXT__": JS_VISIBLE_TEXT,
+    }
+    out = template
+    for token, value in subs.items():
+        out = out.replace(token, value)
+    return out
+
+
+JS_COLLECT_IDS = _render(_JS_COLLECT_IDS)
+JS_EXPAND_MORE = _render(_JS_EXPAND_MORE)
+JS_EXTRACT_CARDS = _render(_JS_EXTRACT_CARDS)
+JS_SCROLL_METRICS = _render(_JS_SCROLL_METRICS)
+JS_GROWTH_PROBE = _render(_JS_GROWTH_PROBE)
+
+# Standalone script, used by the equivalence harness to grade `vtext` against
+# Selenium's WebElement.text on arbitrary elements.
+JS_VISIBLE_TEXT_OF = _render(
+    "return (function (el) {\n"
+    '  "use strict";\n'
+    "__GET_ATTRIBUTE__\n"
+    "__VISIBLE_TEXT__\n"
+    "  return vtext(el);\n"
+    "})(arguments[0]);\n"
+)
+
+
+# --------------------------------------------------------------------------
