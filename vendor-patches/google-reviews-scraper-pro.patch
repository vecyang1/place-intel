+        Replaces the unconditional 0.7/1.0/2.0s sleeps: typical satisfaction is
+        200-400ms, and the deadline bounds the worst case instead of paying it
+        every iteration.
+        """
+        end = time.monotonic() + deadline_s
+        while time.monotonic() < end:
+            probe = dom_batch.growth_probe(driver)
+            if probe is None:
+                return False
+            n, h = probe
+            if (n or 0) > prev_cards or (h or 0) > prev_height:
+                return True
+            time.sleep(GROWTH_POLL_INTERVAL_SECONDS)
+        return False
