+"""Fixtures must carry no real reviewer data.
+
+This scraper's fixtures are captured from live Google Maps pages, and the
+place-intel repo that vendors it publishes this patch to a PUBLIC mirror — so a
+fixture is the one file where a real avatar URL or contributor id becomes
+permanent, world-readable, and attached to a named person.
+
+Measured 2026-08-31: `reviews_fixture.html` shipped 4 real
+`lh*.googleusercontent.com` avatar URLs, 3 real contributor ids and 4 real
+display names, and was already staged inside the tracked vendor patch.
+
+The patterns are assembled from FRAGMENTS so this file does not match itself —
+a detector that spells its own banned strings flags its own source, and the
+obvious fix (exclude this file) carves out the one file guaranteed to
+accumulate them.
+"""
+import re
+from pathlib import Path
+
+import pytest
+
+FIXTURES = Path(__file__).parent / "fixtures"
+_G = "google" + "usercontent"
+_REAL_CONTRIB = re.compile(r"/maps/contrib/" + r"1\d{15,}")
+_REAL_PHOTO = re.compile(r"https://lh\d\." + _G + r"\.com/")
+
+
+def _fixture_files():
+    return sorted(p for p in FIXTURES.rglob("*") if p.is_file())
+
+
+def test_there_are_fixtures_to_grade():
+    # An empty sweep passes every assertion beneath it.
+    assert _fixture_files(), "no fixtures found — this gate has a zero denominator"
+
+
+@pytest.mark.parametrize("path", _fixture_files(), ids=lambda p: p.name)
+def test_fixture_carries_no_real_reviewer_data(path):
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (UnicodeDecodeError, OSError):
+        pytest.skip(f"{path.name} is not text")
+    assert not _REAL_PHOTO.search(text), (
+        f"{path.name} holds a real reviewer photo/avatar URL — replace the host "
+        "with example.invalid")
+    assert not _REAL_CONTRIB.search(text), (
+        f"{path.name} holds a real contributor id — replace it with zeros")
+    print(f"graded {path.name} ({len(text):,} chars)")
