+        ], []]))
+        assert raw.sub_ratings == {"service": 5, "food": 4}
+
+    def test_sub_ratings_precedence_is_observable(self):
+        """The `or` order is only decidable when both fields are populated."""
+        raw = RawReview.from_payload(self.payload(sub_labels=[[
+            {"aria": "Service: 5/5", "text": "Service: 1/5"}], []]))
+        assert raw.sub_ratings == {"service": 5}
