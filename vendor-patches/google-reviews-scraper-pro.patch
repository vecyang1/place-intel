+    def test_sub_ratings_unknown_category_goes_to_other(self):
+        raw = RawReview.from_payload(self.payload(sub_labels=[[
+            {"aria": "Totally unknown xyz: 3/5", "text": None}], []]))
+        assert raw.sub_ratings["_other"]["totally unknown xyz"] == 3
