+                    # 200-400ms; the deadline bounds the worst case.
+                    #
+                    # Baseline is `last_*` — the values `_exhaustion_step` just
+                    # measured — NOT `prev_*`, which are the previous pass's.
+                    # Handed the older, smaller numbers, the very first poll
+                    # already exceeds them on any pass where the pane grew, so
+                    # the function returned True having waited for nothing and
+                    # the loop spun through barren passes instead.
+                    self._wait_for_growth(
+                        driver, last_card_count, last_scroll_height,
+                        GROWTH_DEADLINE_AFTER_HIT_SECONDS if fresh_ids
+                        else GROWTH_DEADLINE_AFTER_MISS_SECONDS,
+                    )
 
                 except StaleElementReferenceException:
                     # The pane or other element went stale, try to re-find
@@ -1885,6 +2218,17 @@ class GoogleReviewsScraper:
                     "Parse errors: %d cards skipped due to parser exceptions",
                     batch_stats["parse_errors"],
                 )
+            if self._batch_cards_total or self._batch_fail_ids:
+                log.info(
+                    "Batched DOM extraction: %d/%d cards batched, "
+                    "%d id-scan fallbacks, %d extract failures, "
+                    "%d coverage gaps, %d empty payloads, %d unexpanded 'More'",
+                    self._batch_cards_total - self._batch_cards_fallback,
+                    self._batch_cards_total,
+                    self._batch_fail_ids, self._batch_fail_extract,
+                    self._batch_fail_missing, self._batch_fail_field,
+                    self._batch_more_left,
+                )
             log.info("Total unique reviews in DB: %d", len(reviews))
 
             end_time = time.time()
