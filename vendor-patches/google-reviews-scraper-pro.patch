+class TestGrowthWaitBaseline:
+    """The growth wait must be seeded with the JUST-MEASURED pane size.
+
+    `_exhaustion_step` returns the freshly-measured (height, cards). Seeding
+    `_wait_for_growth` with the PREVIOUS pass's values instead makes its very
+    first poll exceed the baseline on any pass where the pane grew — so it
+    returns True immediately, waits for nothing, and the loop burns barren
+    passes instead of letting Google deliver the next batch.
+
+    This is a source-level assertion because the defect is an argument-passing
+    mistake in a loop that cannot be exercised without a live review pane; the
+    predicate ("the baseline args are the post-step names") is decidable.
+    """
+
+    def test_wait_for_growth_is_seeded_from_the_fresh_measurement(self):
+        import inspect
+        import re
+
+        from modules.scraper import GoogleReviewsScraper
+
+        src = inspect.getsource(GoogleReviewsScraper._scrape_once)
+        call = re.search(
+            r"self\._wait_for_growth\(\s*driver,\s*([A-Za-z_]+),\s*([A-Za-z_]+)",
+            src,
+        )
+        assert call, "could not find the _wait_for_growth call site"
+        cards_arg, height_arg = call.group(1), call.group(2)
+        assert (cards_arg, height_arg) == ("last_card_count", "last_scroll_height"), (
+            f"_wait_for_growth seeded with ({cards_arg}, {height_arg}); it must use "
+            "the values _exhaustion_step just measured, or the wait is a no-op"
+        )
