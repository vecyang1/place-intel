# placeintel — copy to `.env` and fill in. Nothing here is committed (.env is gitignored).
# All keys are optional individually, but you need at least one Gemini key.

# Gemini via Google official (recommended for EMBEDDING — true batch, fast).
# Get one at https://aistudio.google.com/apikey  (starts with "AIza")
GOOGLE_API_KEY=

# Gemini via a cheaper OpenAI/Gemini-compatible gateway (used for REASONING).
# Any gateway that speaks the Gemini /v1beta API works; key starts with "sk-".
# Optional override if your gateway isn't api.vectorengine.ai:
# VECTORENGINE_BASE_URL=https://api.vectorengine.ai
VECTORENGINE_API_KEY=

# SerpAPI — optional, and BILLABLE. Only used as a fallback when the free
# scrapers can't run. Get one at https://serpapi.com  (~1 credit / 20 reviews)
SERPAPI_API_KEY=

# Permission for that paid fallback. Unset or 0 = a failed free scrape STOPS and
# says why, instead of quietly buying the same data. Set to 1 only if you would
# rather pay than get an error when Docker or the vendored scraper is down.
# PLACEINTEL_ALLOW_SERPAPI=0

# --- Optional behaviour knobs (sensible defaults; uncomment to override) -------
# PLACEINTEL_REASON_MODEL=gemini-2.5-flash      # default reasoning model
# PLACEINTEL_EMBED_MODEL=gemini-embedding-2-preview
# PLACEINTEL_EMBED_DIMS=768
# PLACEINTEL_PLACE_TTL_DAYS=14                   # cached place details staleness
# PLACEINTEL_EVIDENCE_LANG=report               # "report" = translate quotes; "original" = verbatim
# PLACEINTEL_DATA_DIR=./data
# PLACEINTEL_SAVED_IMPORT_MAX_FILES=5000        # supported archive/directory files
# PLACEINTEL_SAVED_IMPORT_MAX_ROWS=250000       # parsed saved rows per import
# PLACEINTEL_SAVED_IMPORT_MAX_FILE_MB=25        # one uncompressed CSV/GeoJSON member
# PLACEINTEL_SAVED_IMPORT_MAX_TOTAL_MB=1024     # total uncompressed input bytes

# --- Error tracking (optional; disabled unless a DSN is set) --------------------
# SENTRY_DSN=                                   # Sentry project DSN; empty = off
# SENTRY_ENVIRONMENT=development                # deploy lane sets "production"
# SENTRY_TRACES_SAMPLE_RATE=0.1                 # 0..1; safe default is 10%
# PLACEINTEL_MONITOR_TOKEN=                      # dedicated external readiness token

# --- Sharing guards (set both when the app is reachable by anyone but you) -----
# PLACEINTEL_OWNER_TOKEN=                       # owner-only routes; UNSET = those routes refuse
# PLACEINTEL_DAILY_JOB_LIMIT=50                 # rolling-24h scout/shop ceiling; 0 = unlimited
